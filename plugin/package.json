{
  "name": "@prometheus-ags/opencode-codex-proxy",
  "version": "0.2.0",
  "description": "OpenCode 2.x subscription provider for openai-proxy",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --format esm --target bun --external @opencode/plugin && bun build ./src/login.mjs --outfile ./dist/login.mjs --format esm --target node"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.0"
  },
  "license": "MIT"
}
