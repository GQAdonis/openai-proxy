{
  "name": "@prometheus-ags/opencode-codex-proxy",
  "version": "0.1.0",
  "description": "OpenCode plugin: routes requests through openai-proxy → Codex Responses API using your ChatGPT subscription",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --declaration --declarationMap --outDir dist --emitDeclarationOnly && bun build src/index.ts --outdir dist --format esm --target bun",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "dev": "bun run src/index.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.12",
    "@types/node": "^25.9.1",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "effect": "4.0.0-beta.103",
    "toml": "5.0.1",
    "zod": "4.6.7"
  },
  "keywords": ["opencode", "opencode-plugin", "codex", "openai", "proxy"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
